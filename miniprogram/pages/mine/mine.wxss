/* pages/mine/mine.wxss */
.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.user-card {
  background-color: white;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(1, 18, 85, 0.04);
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid #c7d2fe;
}

.user-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #1e293b;
}

.user-id {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.badge-vip {
  font-size: 20rpx;
  font-weight: bold;
  background-color: #fef3c7;
  color: #d97706;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.quick-stats {
  display: flex;
  justify-content: space-around;
  background-color: white;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(1, 18, 85, 0.04);
  margin-bottom: 24rpx;
}

.stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a237e;
}

.stat-label {
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.menu-list {
  background-color: white;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(1, 18, 85, 0.04);
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1.5rpx solid #f1f5f9;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 28rpx;
}

.menu-text {
  font-size: 24rpx;
  color: #334155;
  margin-left: 16rpx;
}

.menu-arrow {
  color: #cbd5e1;
  font-size: 20rpx;
}
