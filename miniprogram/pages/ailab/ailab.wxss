/* pages/ailab/ailab.wxss */
.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.panel-card {
  background-color: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(1, 18, 85, 0.04);
}

.panel-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.panel-icon {
  font-size: 32rpx;
}

.panel-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #1e293b;
  margin-left: 8rpx;
}

.input-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 12rpx;
  display: block;
}

.title-textarea {
  width: 100%;
  height: 160rpx;
  border: 1.5rpx solid #cbd5e1;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 24rpx;
  box-sizing: border-box;
  background-color: #f8fafc;
}

.submit-btn {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #1a237e, #4338ca);
  color: white;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 16rpx;
  padding: 16rpx 0;
}

.result-card {
  background-color: #f7fee7;
  border: 1.5rpx solid #d9f99d;
}

.result-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #3f6212;
  text-align: center;
}

.score-display {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin: 16rpx 0;
}

.score-num {
  font-size: 72rpx;
  font-weight: bold;
  color: #4d7c0f;
}

.score-unit {
  font-size: 24rpx;
  color: #4d7c0f;
  margin-left: 4rpx;
}

.result-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #475569;
}

.result-value {
  font-weight: bold;
  color: #1a237e;
}

.suggestions-box {
  border-top: 1.5rpx dashed #d9f99d;
  padding-top: 24rpx;
}

.box-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #3f6212;
  margin-bottom: 8rpx;
}

.suggestion-item {
  display: flex;
  font-size: 22rpx;
  color: #4f5e2d;
  line-height: 1.6;
  gap: 8rpx;
}

.dot {
  color: #4d7c0f;
}
