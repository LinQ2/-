/* pages/profile/profile.wxss */
.container {
  background-color: #f7f9fc;
  padding: 32rpx;
  box-sizing: border-box;
}

.profile-header {
  background: white;
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(1, 18, 85, 0.04);
}

.avatar-ring {
  width: 160rpx;
  height: 160rpx;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #1a237e, #06b6d4);
  padding: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 100rpx;
}

.name {
  font-size: 38rpx;
  font-weight: bold;
  color: #1e293b;
  margin-top: 24rpx;
}

.handle {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.tags {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag {
  font-size: 20rpx;
  font-weight: bold;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.tag.xhs {
  background-color: #fef2f2;
  color: #ef4444;
}

.tag.dy {
  background-color: #e0f2fe;
  color: #3b82f6;
}

/* KPI rows */
.kpi-row {
  display: flex;
  width: 100%;
  justify-content: space-around;
  border-t: 1.5rpx solid #f1f5f9;
  margin-top: 32rpx;
  padding-top: 24rpx;
}

.kpi-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.kpi-val {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a237e;
}

.kpi-label {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

/* Bi-card Grid Section */
.grid-section {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.fit-card, .potential-card {
  flex: 1;
  background-color: white;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(1, 18, 85, 0.04);
}

.card-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #475569;
  border-left: 6rpx solid #1a237e;
  padding-left: 12rpx;
}

.score-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 140rpx;
}

.big-score {
  font-size: 56rpx;
  font-weight: bold;
  color: #1a237e;
}

.score-sub {
  font-size: 20rpx;
  color: #10b981;
  font-weight: bold;
}

.progress-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.prog-item {
  display: flex;
  flex-direction: column;
}

.prog-label {
  font-size: 18rpx;
  color: #64748b;
  margin-bottom: 4rpx;
}

/* Trend charts */
.trend-section, .demographics-section {
  background-color: white;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(1, 18, 85, 0.04);
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #1e293b;
}

.section-sub {
  font-size: 18rpx;
  color: #94a3b8;
}

.bar-chart {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 140rpx;
  border-bottom: 1.5rpx solid #e2e8f0;
  padding-bottom: 8rpx;
}

.bar-item {
  width: 40rpx;
  background: linear-gradient(to top, #1a237e, #06b6d4);
  border-radius: 6rpx;
}

.chart-labels {
  display: flex;
  justify-content: space-between;
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

/* Demographics charts */
.demo-grid {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.gender-block, .age-block {
  flex: 1;
}

.sub-title {
  font-size: 20rpx;
  font-weight: bold;
  color: #64748b;
  margin-bottom: 12rpx;
  display: block;
}

.pie-sim {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
  font-size: 20rpx;
}

.color-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
}

.xhs-color { background-color: #ef4444; }
.dy-color { background-color: #3b82f6; }

.age-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
  font-size: 18rpx;
}

.age-range {
  width: 60rpx;
}

.age-percent-bar {
  flex: 1;
}

.age-num {
  width: 40rpx;
  text-align: right;
  font-weight: bold;
}
