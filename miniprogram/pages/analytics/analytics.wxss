/* pages/analytics/analytics.wxss */
.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.panel-card {
  background-color: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(1, 18, 85, 0.04);
}

.panel-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.panel-icon {
  font-size: 32rpx;
}

.panel-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #1e293b;
  margin-left: 8rpx;
}

.picker-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1.5rpx solid #f1f5f9;
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
}

.picker-label {
  font-size: 24rpx;
  color: #64748b;
}

.picker-display {
  font-size: 24rpx;
  font-weight: bold;
  color: #1a237e;
  border: 1.5rpx solid #c7d2fe;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  background-color: #f5f3ff;
}

.stats-row {
  display: flex;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a237e;
}

.stat-label {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.brand-bar-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.brand-bar-item {
  display: flex;
  flex-direction: column;
}

.brand-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
  font-size: 22rpx;
}

.brand-name {
  color: #475569;
}

.brand-val {
  color: #1a237e;
  font-weight: bold;
}
